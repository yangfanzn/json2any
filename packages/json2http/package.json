{
  "name": "json2http",
  "version": "1.2.0",
  "description": "json2http is a CLI tool that depends on json2class for generating code from JSON or JSON5, enabling HTTP-based requests.",
  "keywords": [
    "http request",
    "http",
    "https",
    "json2http",
    "json2class",
    "json",
    "json5",
    "class",
    "cli",
    "config",
    "transform",
    "code generation",
    "code build",
    "serialization",
    "deserialization",
    "typescript",
    "dart",
    "arkTs"
  ],
  "author": "Yang Fan<yangfanzn@gmail.com>",
  "license": "ISC",
  "repository": "https://github.com/yangfanzn/json2any",
  "homepage": "https://github.com/yangfanzn/json2any/tree/main/packages/json2http",
  "scripts": {
    "build": "webpack",
    "dev": "webpack --watch"
  },
  "files": [
    "lib",
    "types"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./bin": {
      "types": "./types/bin.d.ts",
      "default": "./lib/bin.js"
    }
  },
  "types": "./types/",
  "bin": {
    "json2http": "./lib/json2http"
  }
}
